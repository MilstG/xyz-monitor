{
  "name": "xyz-monitor",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "description": "Server-cached monitor for HIP-3 perp markets on Hyperliquid (dex: xyz)",
  "engines": {
    "node": ">=22.5 <25"
  },
  "scripts": {
    "start": "node --experimental-sqlite server.js",
    "test": "node --experimental-sqlite --test --test-timeout=120000 'test/*.test.js'",
    "test:cov": "node --experimental-sqlite --test --test-timeout=120000 --experimental-test-coverage --test-coverage-exclude='test/**' 'test/*.test.js'",
    "lint": "eslint .",
    "audit": "npm audit --audit-level=high",
    "bench": "node --experimental-sqlite scripts/bench-builds.js"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/static": "^10.1.3",
    "@tesseract.js-data/eng": "^1.0.0",
    "fastify": "^5.12.4",
    "tesseract.js": "^7.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "eslint": "^10.10.0",
    "globals": "^17.12.0"
  }
}
