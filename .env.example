# Milst Screener — environment. Copy to .env for local runs (nothing reads .env automatically;
# export it or use `env $(cat .env) npm start`). Railway: set these on the service.
# Every variable the code reads is listed here; the value shown is the default when unset.

# ---- storage & runtime ------------------------------------------------------------------------
DATA_DIR=/data                 # the mounted volume; unset = ./data inside the container (ephemeral on Railway)
ACCOUNTS_BACKUP_DIR=           # a second mount for the rotated accounts.db copies (default: <DATA_DIR>/backups)
PORT=3000                      # listen port
DEX=xyz                        # Hyperliquid HIP-3 dex whose universe the equities lane polls
CRYPTO=1                       # 0 disables the crypto universe (BTC/ETH perps lane) entirely
TRUST_PROXY=1                  # 1 = one trusted edge appends the last X-Forwarded-For element (Railway); 0 when exposed directly
PUBLIC_URL=                    # https://… used in push/Telegram links
CSP_ENFORCE=0                  # 1 enforces the Content-Security-Policy (default: report-only; watch /api/health csp.reports stay 0 first)
XYZ_QUIET=                     # any value silences the server's timestamped stdout log
XYZ_NO_NET=                    # any value rejects every outbound request (tests + offline dev)
# RAILWAY_ENVIRONMENT          # set by Railway itself; only changes the wording of boot warnings

# ---- access -----------------------------------------------------------------------------------
SITE_PASSWORD=                 # shared door; unset = the read-only site is open, AI routes and /claim closed
SITE_USER=friend
LEGACY_SHARED_PASSWORD=1       # 0 once everyone has an account
SESSION_SECRET=                # HMAC key for legacy-door sessions; unset = derived from the accounts secret
SESSION_DAYS=30                # account session lifetime
ADMIN_PASSWORD=                # break-glass operator login and `admin unlock`; unset = no admin surface at all
ADMIN_DAYS=30                  # admin (xyzadm) cookie lifetime
DM_ESCALATE_MS=300000          # how long a DM sits unread before it escalates to a push/Telegram nudge

# ---- data sources -----------------------------------------------------------------------------
SEC_CONTACT=you@example.com    # goes in the SEC user-agent; their fair-access policy wants a real contact
FINNHUB_TOKEN=                 # earnings calendar, company news, fundamentals
FRED_KEY=                      # housing + liquidity tabs
COINALYZE_API_KEY=             # crypto liquidation/OI lane
TG_BOT_TOKEN=                  # Telegram alerts, DMs escalation, password-reset codes
PUSH_VAPID_SUBJECT=mailto:ops@example.com   # contact sent with web-push VAPID claims

# ---- ledger off-site backup (weekly, GitHub contents API; off unless REPO and a token are set) --
LEDGER_BACKUP_REPO=            # owner/repo for the ledger GitHub backup
LEDGER_BACKUP_TOKEN=           # PAT with contents:write on that repo (falls back to GITHUB_TOKEN)
GITHUB_TOKEN=                  # only read as the LEDGER_BACKUP_TOKEN fallback
LEDGER_BACKUP_BRANCH=main

# ---- AI: provider & models ---------------------------------------------------------------------
ANTHROPIC_API_KEY=             # or OPENAI_API_KEY; AI_PROVIDER picks when both are set
OPENAI_API_KEY=
AI_PROVIDER=                   # anthropic | openai; default = whichever key is set (anthropic when both)
AI_MODEL=                      # report/ask model (anthropic: claude-fable-5, openai: gpt-5.6-terra)
AI_MODEL_FALLBACK=             # tried when AI_MODEL errors (claude-opus-4-8 / gpt-5.6-sol)
AI_CLASSIFY_MODEL=             # unattended news/sector classifier (claude-haiku-4-5 / gpt-5.4-nano)
AI_CLASSIFY_EFFORT=low         # reasoning effort for the classifier (low | medium | high)
AI_REPORT_EFFORT=high          # reasoning effort for ticker/group reports
AI_ASK_EFFORT=medium           # reasoning effort for the terminal `ask` fallback
AI_REPORT_TTL_MIN=30           # cached report lifetime (minimum 5)

# ---- AI: budgets (shared pools roll at midnight UTC and persist across redeploys) --------------
AI_REPORTS_PER_DAY=5           # successful report generations per day, whole group
AI_USER_PER_DAY=3              # per-user report cap (admins are exempt)
AI_USER_PER_MONTH=20           # per-user monthly report cap
ASK_MAX_PER_MIN=12             # terminal ask window, whole group
ASK_MAX_PER_DAY=50             # successful ask model calls per day, whole group
ASK_USER_PER_DAY=5             # per-user ask cap

# ---- AI: scheduled morning brief ----------------------------------------------------------------
BRIEF_ENABLED=1                # 0 disables the brief entirely
BRIEF_DEFAULT_HOUR=10          # UTC hour the brief is generated (0-23; 0 is honoured)
BRIEF_PER_DAY=6                # manual regenerations per day
BRIEF_EFFORT=medium
BRIEF_MODEL=                   # default AI_MODEL
BRIEF_MODEL_FALLBACK=          # default AI_MODEL_FALLBACK
BRIEF_MAX_TOKENS=12000         # never below the provider's report budget

# ---- AI: landscape commentary -------------------------------------------------------------------
LANDSCAPE_ENABLED=1
LANDSCAPE_DEFAULT_HOUR=        # UTC hour (0-23); unset = the schedule registry's own default
LANDSCAPE_PER_DAY=4
LANDSCAPE_EFFORT=high
LANDSCAPE_MODEL=               # default BRIEF_MODEL
LANDSCAPE_MODEL_FALLBACK=      # default BRIEF_MODEL_FALLBACK
LANDSCAPE_MAX_TOKENS=12000
