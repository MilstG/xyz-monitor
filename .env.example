# Milst Screener — environment. Copy to .env for local runs (nothing reads .env automatically;
# export it or use `env $(cat .env) npm start`). Railway: set these on the service.
DATA_DIR=/data                 # the mounted volume; unset = ./data inside the container (ephemeral on Railway)
SITE_PASSWORD=                 # shared door; unset = the read-only site is open, AI routes and /claim closed
SITE_USER=friend
ADMIN_PASSWORD=                # break-glass operator login and `admin unlock`; unset = no admin surface at all
LEGACY_SHARED_PASSWORD=1       # 0 once everyone has an account
SEC_CONTACT=you@example.com    # goes in the SEC user-agent; their fair-access policy wants a real contact
FINNHUB_TOKEN=                 # earnings calendar, company news, fundamentals
FRED_KEY=                      # housing + liquidity tabs
COINALYZE_API_KEY=             # crypto liquidation/OI lane
TG_BOT_TOKEN=                  # Telegram alerts, DMs escalation, password-reset codes
PUBLIC_URL=                    # https://… used in push links
ANTHROPIC_API_KEY=             # or OPENAI_API_KEY; AI_PROVIDER picks when both are set
ACCOUNTS_BACKUP_DIR=           # a second mount for the rotated accounts.db copies (default: <DATA_DIR>/backups)
TRUST_PROXY=1                  # 0 when not behind Railway's edge
LEDGER_BACKUP_REPO=            # owner/repo for the ledger GitHub backup (+ LEDGER_BACKUP_TOKEN)
